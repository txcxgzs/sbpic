# 服务端口
PORT=8321

# 对外访问域名（用于生成链接，不要带末尾斜杠）
BASE_URL=http://localhost:8321

# 单文件大小上限（MB）
MAX_SIZE_MB=20

# 每 IP 每分钟上传次数上限
RATE_LIMIT_PER_MIN=30

# ===== Cloudflare R2 =====
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET=sbimg

# ===== MySQL =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=sbimg
DB_PASSWORD=your-db-password
DB_NAME=sbimg

# ===== 会话与认证 =====
# session 加密密钥，请改成随机长串（至少16字符）
SESSION_SECRET=change-me-to-a-long-random-string
# 信任的反代跳数：直连填0，一层反代填1，Cloudflare+nginx填2
TRUST_PROXY=1
# 生产环境用 HTTPS 时设为 true，cookie 才会带 secure
COOKIE_SECURE=false

# 初始管理员（首次启动时若 users 表为空会自动创建）
INIT_ADMIN_USER=admin
# 留空则启动时随机生成密码并打印到控制台
INIT_ADMIN_PASS=

# 是否开放注册（true/false）
ALLOW_REGISTER=true
# 每 IP 每 10 分钟注册次数上限
REGISTER_LIMIT_PER_10MIN=3

# ===== 邮件（SMTP，兼容 Brevo 及任意 SMTP 服务商）=====
# 关闭则注册直接创建已验证用户（应急本地用）
MAIL_ENABLED=true
SMTP_HOST=smtp-relay.brevo.net
SMTP_PORT=587
SMTP_USER=your-brevo-login-email
SMTP_PASS=your-brevo-smtp-key
SMTP_FROM=烧饼图床 <noreply@example.com>
# 用于生成验证链接（一般与 BASE_URL 相同）
APP_URL=http://localhost:8321

# ===== Cloudflare Turnstile 人机验证（仅注册）=====
# 关闭则注册不校验（本地调试用）
TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=your-site-key
TURNSTILE_SECRET_KEY=your-secret-key

# ===== 限流参数（可选，覆盖默认值）=====
# 全局每 IP 每分钟请求数（防扫描）
GLOBAL_LIMIT_PER_MIN=300
# 上传每 IP 每分钟次数
UPLOAD_LIMIT_PER_MIN=100
# 上传每用户每分钟次数
UPLOAD_LIMIT_PER_USER_PER_MIN=60
# 图片访问 /i/* 每 IP 每分钟次数
VIEW_LIMIT_PER_MIN=600
# 登录连续失败多少次后封禁该 IP+用户名
LOGIN_FAIL_THRESHOLD=5
# 登录封禁分钟数
LOGIN_BAN_MINUTES=15
# 同时处理的上传请求数上限（超出返 503）
UPLOAD_CONCURRENCY=20
