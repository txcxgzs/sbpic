# 烧饼图床 .env 配置
# 注意：这里只放启动必需项（数据库、session、端口、初始管理员）
#       R2 / 邮件 / Turnstile / 限流 / 站点URL 等业务配置不在这里
#       启动后登录后台「系统设置」页面配置，改完即时生效。

# 服务端口
PORT=8321

# ===== MySQL =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=sbimg
DB_PASSWORD=your-db-password
DB_NAME=sbimg

# ===== 会话与认证 =====
# session 加密密钥，请改成随机长串（至少16字符）
SESSION_SECRET=change-me-to-a-long-random-string
# 信任的反代跳数：直连填0，一层反代填1，Cloudflare+nginx填2
TRUST_PROXY=1
# 生产环境用 HTTPS 时设为 true，cookie 才会带 secure
COOKIE_SECURE=false

# ===== 初始管理员 =====
# 首次启动时若 users 表为空会自动创建
INIT_ADMIN_USER=admin
# 留空则启动时随机生成密码并打印到控制台
INIT_ADMIN_PASS=
