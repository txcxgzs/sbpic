# 服务端口
PORT=3000

# 对外访问域名（用于生成图片链接，不要带末尾斜杠）
BASE_URL=http://localhost:3000

# 单文件大小上限（MB）
MAX_SIZE_MB=20

# 每 IP 每分钟上传次数上限
RATE_LIMIT_PER_MIN=30

# ===== Cloudflare R2 =====
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET=sbimg

# ===== MySQL =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=sbimg
DB_PASSWORD=your-db-password
DB_NAME=sbimg

# ===== 会话与认证 =====
# session 加密密钥，请改成随机长串（至少16字符）
SESSION_SECRET=change-me-to-a-long-random-string
# 信任的反代跳数：直连填0，一层反代填1，Cloudflare+nginx填2
TRUST_PROXY=1
# 生产环境用 HTTPS 时设为 true，cookie 才会带 secure
COOKIE_SECURE=false

# 初始管理员（首次启动时若 users 表为空会自动创建）
INIT_ADMIN_USER=admin
# 留空则启动时随机生成密码并打印到控制台
INIT_ADMIN_PASS=

# 是否开放注册（true/false）
ALLOW_REGISTER=true
# 每 IP 每 10 分钟注册次数上限
REGISTER_LIMIT_PER_10MIN=3
